<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 368x448 Xiaomi Mi Watch - Estilo ChatGPT Voice Live -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Orbe animado central (ChatGPT Voice Live) -->
    <FrameLayout
        android:id="@+id/orb_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <io.xenxo.wristai.VoiceOrbView
            android:id="@+id/voice_orb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>

    <!-- Barra superior minimalista -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Pill de proveedor (Auto / Groq / Gemini...) -->
        <Button
            android:id="@+id/provider"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_voice_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="1dp"
            android:paddingEnd="10dp"
            android:paddingBottom="1dp"
            android:text="⚡ Auto"
            android:textAllCaps="false"
            android:textColor="#E0E0E0"
            android:textSize="10sp" />

        <!-- Subtítulo de estado / pregunta / respuesta breve -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:text="Toca 🎤 o el orbe para hablar" />

    </LinearLayout>

    <!-- Lámina deslizable de transcripción y métricas (oculta por defecto) -->
    <ScrollView
        android:id="@+id/transcript_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="#FA0B0B0E"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="68dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabecera de la transcripción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheet_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Conversación"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_close_sheet"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_voice_pill"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="✕"
                    android:textColor="#A0A0A5"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:text="Mantén 🎤 para hablar o toca el orbe." />

            <!-- Dashboard de 4 Cuadrantes de salud local -->
            <LinearLayout
                android:id="@+id/dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Métricas en reloj"
                    android:textColor="#636366"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_dash_weight"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dash_card"
                        android:gravity="center"
                        android:padding="2dp"
                        android:text="⚖️ Peso"
                        android:textAllCaps="false"
                        android:textColor="#FFB300"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_dash_gym"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dash_card"
                        android:gravity="center"
                        android:padding="2dp"
                        android:text="🏋️ Gym"
                        android:textAllCaps="false"
                        android:textColor="#26C6DA"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_dash_padel"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dash_card"
                        android:gravity="center"
                        android:padding="2dp"
                        android:text="🎾 Pádel"
                        android:textAllCaps="false"
                        android:textColor="#81C784"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_dash_battery"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dash_card"
                        android:gravity="center"
                        android:padding="2dp"
                        android:text="🔋 Batería"
                        android:textAllCaps="false"
                        android:textColor="#B0BEC5"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_dash_sos"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sos_card"
                    android:text="🚨 Urgencia: 112"
                    android:textAllCaps="false"
                    android:textColor="#EF5350"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra de control inferior: 4 botones circulares (estilo ChatGPT Voice Live) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- Botón 1: Alternar transcripción / dashboard -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn_sheet_toggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_voice_circle_btn"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📄"
                android:textColor="#E0E0E0"
                android:textSize="15sp" />
        </FrameLayout>

        <!-- Botón 2: Micrófono / Hablar -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/mic"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_voice_circle_btn"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="🎤"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />
        </FrameLayout>

        <!-- Botón 3: Opciones / Cambiar proveedor -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn_options"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_voice_circle_btn"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="···"
                android:textColor="#E0E0E0"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Botón 4: Salir / Cancelar -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_voice_circle_btn"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="✕"
                android:textColor="#E0E0E0"
                android:textSize="15sp" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
